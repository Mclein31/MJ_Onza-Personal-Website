{
 "version": 1,
 "title": "Personal Website",
 "summary": "A zero-build, single-page portfolio for a developer: an animated static site on Vercel with two small serverless proxies for visit/like counts and the GitHub contribution graph.",
 "nodes": [
  {
   "id": "visitor",
   "label": "Visitor",
   "kind": "actor",
   "layer": "frontend",
   "detail": "Recruiter or peer browsing the portfolio, viewing projects, liking and messaging.",
   "file": ""
  },
  {
   "id": "ui.page",
   "label": "Single page (index)",
   "kind": "screen",
   "layer": "frontend",
   "detail": "The one-page site: hero, work, journey, skills, awards, contact wallet and footer.",
   "file": "index.html"
  },
  {
   "id": "ui.main",
   "label": "main.js bootstrap",
   "kind": "component",
   "layer": "frontend",
   "detail": "Entry module that runs each core init, then the design steps, each in its own try/catch, and fires site:ready.",
   "file": "scripts/main.js"
  },
  {
   "id": "ui.hero",
   "label": "Hero and icons",
   "kind": "component",
   "layer": "frontend",
   "detail": "Instrument hero: raw WebGL Extract-Transform-Load point field with SVG fallback and nav readout.",
   "file": "scripts/design/hero.js"
  },
  {
   "id": "ui.work",
   "label": "Work showcase",
   "kind": "component",
   "layer": "frontend",
   "detail": "Work spec sheets with a clip-path wipe flourish on slide change and a mouse-only \"View\" cursor over screenshots.",
   "file": "scripts/design/work.js"
  },
  {
   "id": "ui.viewer",
   "label": "Lightbox",
   "kind": "component",
   "layer": "frontend",
   "detail": "Single dialog for project screenshots and certificate photos.",
   "file": "scripts/core/viewer.js"
  },
  {
   "id": "ui.activity",
   "label": "GitHub activity",
   "kind": "component",
   "layer": "frontend",
   "detail": "Renders the GitHub contribution calendar, totals, streaks and the contact mini grid.",
   "file": "scripts/core/activity.js"
  },
  {
   "id": "ui.contact",
   "label": "Message dialog",
   "kind": "component",
   "layer": "frontend",
   "detail": "Contact dialog that posts the message to FormSubmit with a honeypot and states.",
   "file": "scripts/core/contact.js"
  },
  {
   "id": "ui.stats",
   "label": "Visit and like counters",
   "kind": "component",
   "layer": "frontend",
   "detail": "Shows totals, counts one visit and one like per browser through /api/stats, falls back to Abacus for reads only.",
   "file": "scripts/core/stats.js"
  },
  {
   "id": "ui.theme",
   "label": "Theme",
   "kind": "component",
   "layer": "frontend",
   "detail": "Light/dark theme manager that persists the choice.",
   "file": "scripts/core/theme.js"
  },
  {
   "id": "ui.gallery",
   "label": "Project galleries",
   "kind": "component",
   "layer": "frontend",
   "detail": "Scroll-snap screenshot carousels inside each Work spec sheet.",
   "file": "scripts/core/gallery.js"
  },
  {
   "id": "ui.video",
   "label": "Promo videos",
   "kind": "component",
   "layer": "frontend",
   "detail": "Promo video dialog that plays with sound and unloads on close.",
   "file": "scripts/core/video.js"
  },
  {
   "id": "ui.reveal",
   "label": "Reveal helpers",
   "kind": "component",
   "layer": "frontend",
   "detail": "Page-wide rise, draw, fade, number-tick and scan-wipe reveals driven by data-reveal attributes, held until the intro finishes.",
   "file": "scripts/design/reveal.js"
  },
  {
   "id": "ui.journey",
   "label": "Pinned journey",
   "kind": "component",
   "layer": "frontend",
   "detail": "Vertical-spine journey log motion.",
   "file": "scripts/design/journey.js"
  },
  {
   "id": "store.local",
   "label": "Browser storage",
   "kind": "store",
   "layer": "frontend",
   "detail": "localStorage and sessionStorage for theme, cached totals, visited and liked flags, and the intro-seen flag.",
   "file": "scripts/core/theme.js"
  },
  {
   "id": "cfg.css",
   "label": "CSS tokens",
   "kind": "config",
   "layer": "frontend",
   "detail": "Design tokens for colour, type and motion, with a dark override.",
   "file": "styles/tokens.css"
  },
  {
   "id": "api.stats",
   "label": "/api/stats",
   "kind": "api",
   "layer": "backend",
   "detail": "Vercel function that proxies visit and like counters and sets a one-year visited cookie.",
   "file": "api/stats.js"
  },
  {
   "id": "api.contrib",
   "label": "/api/contributions",
   "kind": "api",
   "layer": "backend",
   "detail": "Vercel function that scrapes the public GitHub contribution calendar into JSON, edge cached an hour.",
   "file": "api/contributions.js"
  },
  {
   "id": "ext.abacus",
   "label": "Abacus counter API",
   "kind": "external",
   "layer": "external",
   "detail": "Free no-auth counter service holding portfolio views and likes.",
   "file": ""
  },
  {
   "id": "ext.github",
   "label": "GitHub",
   "kind": "external",
   "layer": "external",
   "detail": "Public contributions page that is the source of the activity graph.",
   "file": ""
  },
  {
   "id": "ext.jogruber",
   "label": "Contributions fallback",
   "kind": "external",
   "layer": "external",
   "detail": "github-contributions-api.jogruber.de, used when the own function fails.",
   "file": ""
  },
  {
   "id": "ext.formsubmit",
   "label": "FormSubmit",
   "kind": "external",
   "layer": "external",
   "detail": "Third-party form endpoint that emails contact messages to the owner.",
   "file": ""
  },
  {
   "id": "ext.vercel",
   "label": "Vercel hosting",
   "kind": "external",
   "layer": "external",
   "detail": "Hosts the static files and runs the serverless functions.",
   "file": ""
  },
  {
   "id": "dec.liked",
   "label": "Already liked?",
   "kind": "decision",
   "layer": "frontend",
   "detail": "Checks the browser flag so each visitor can like only once.",
   "file": "scripts/core/stats.js"
  },
  {
   "id": "dec.stats",
   "label": "Own stats API ok?",
   "kind": "decision",
   "layer": "frontend",
   "detail": "Uses /api/stats when it answers with a count, otherwise falls back to Abacus (never for a first-visit increment).",
   "file": "scripts/core/stats.js"
  },
  {
   "id": "dec.contrib",
   "label": "Own contrib API ok?",
   "kind": "decision",
   "layer": "frontend",
   "detail": "Tries /api/contributions first and moves on to the jogruber fallback when it fails or is empty.",
   "file": "scripts/core/contributions.js"
  },
  {
   "id": "dec.sent",
   "label": "Message sent?",
   "kind": "decision",
   "layer": "frontend",
   "detail": "Shows a success note when FormSubmit responds ok, otherwise an error with the email address.",
   "file": "scripts/core/contact.js"
  },
  {
   "id": "core.motion",
   "label": "Motion and scroll",
   "kind": "component",
   "layer": "frontend",
   "detail": "GSAP, ScrollTrigger and Lenis setup, plus the shared scroll lock.",
   "file": "scripts/core/motion.js"
  },
  {
   "id": "core.nav",
   "label": "Header nav",
   "kind": "component",
   "layer": "frontend",
   "detail": "Scroll-spy, hide on scroll, phone menu and anchor routing.",
   "file": "scripts/core/nav.js"
  },
  {
   "id": "core.intro",
   "label": "Intro gate",
   "kind": "component",
   "layer": "frontend",
   "detail": "Decides once per session whether the column-scan loader plays and fires intro:done.",
   "file": "scripts/core/intro.js"
  },
  {
   "id": "core.page",
   "label": "Page and copy",
   "kind": "component",
   "layer": "frontend",
   "detail": "Sets the year and copies [data-copy] values with a toast.",
   "file": "scripts/core/page.js"
  },
  {
   "id": "core.toast",
   "label": "Toast",
   "kind": "component",
   "layer": "frontend",
   "detail": "Polite live region for short messages.",
   "file": "scripts/core/toast.js"
  },
  {
   "id": "core.gl",
   "label": "WebGL helper",
   "kind": "component",
   "layer": "frontend",
   "detail": "Decides if WebGL runs, caps DPR and drives a visibility-aware render loop.",
   "file": "scripts/core/gl.js"
  },
  {
   "id": "ui.about",
   "label": "About",
   "kind": "component",
   "layer": "frontend",
   "detail": "Rising ink About field motion.",
   "file": "scripts/design/about.js"
  },
  {
   "id": "ui.stack",
   "label": "Stack tables",
   "kind": "component",
   "layer": "frontend",
   "detail": "Interactive stack schema tables.",
   "file": "scripts/design/stack.js"
  },
  {
   "id": "ui.recognition",
   "label": "Recognition and training",
   "kind": "component",
   "layer": "frontend",
   "detail": "Editorial indexes with desktop hover previews that open certificates in the lightbox.",
   "file": "scripts/design/recognition.js"
  },
  {
   "id": "ui.footer",
   "label": "Footer dot matrix",
   "kind": "component",
   "layer": "frontend",
   "detail": "Dot-matrix wordmark on a 2D canvas, the Load end of the hero pipeline.",
   "file": "scripts/design/footer.js"
  },
  {
   "id": "ui.scrollbar",
   "label": "Custom scrollbar",
   "kind": "component",
   "layer": "frontend",
   "detail": "Page scrollbar rail for fine pointers.",
   "file": "scripts/design/scrollbar.js"
  },
  {
   "id": "ui.designidx",
   "label": "Design steps",
   "kind": "component",
   "layer": "frontend",
   "detail": "Imports and inits each design area module in order.",
   "file": "scripts/design/index.js"
  },
  {
   "id": "ui.contactdesign",
   "label": "Contact design",
   "kind": "component",
   "layer": "frontend",
   "detail": "Typed query readout, channel cards and dialog motion.",
   "file": "scripts/design/contact.js"
  },
  {
   "id": "ui.contribs",
   "label": "Contributions loader",
   "kind": "component",
   "layer": "frontend",
   "detail": "Loads the contribution list from the own API, then the fallback.",
   "file": "scripts/core/contributions.js"
  }
 ],
